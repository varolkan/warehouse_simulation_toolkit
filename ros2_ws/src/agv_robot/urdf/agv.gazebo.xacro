<?xml version="1.0"?>
<!--
  Gazebo Harmonic (gz-sim 8) parts of the AGV: tyre and caster friction, the LiDAR and IMU
  sensors, the differential drive, wheel joint states and the joint that holds the load.

  Topic names are absolute so they do not depend on the model name; agv_gazebo's
  config/bridge.yaml maps each of them to ROS.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="agv_gazebo" params="wheel_radius wheel_separation load_joint load_model">

    <xacro:macro name="tyre" params="side">
      <gazebo reference="${side}_wheel_link">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1e6</kp>
        <kd>100</kd>
      </gazebo>
    </xacro:macro>
    <xacro:tyre side="left"/>
    <xacro:tyre side="right"/>

    <!-- Ball casters: no friction, they only stop the body pitching onto the floor. -->
    <gazebo reference="front_caster_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
    <gazebo reference="rear_caster_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>

    <gazebo reference="lidar_link">
      <sensor name="lidar" type="gpu_lidar">
        <topic>/scan_raw</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <!-- 720 beams, 0.5 degrees apart, -180 to +179.5: no doubled beam at the seam. -->
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.13286600</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.08</min>
            <max>16.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>

    <gazebo reference="imu_link">
      <sensor name="imu" type="imu">
        <topic>/imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>

    <gazebo>
      <!--
        Wheel-encoder odometry and velocity control. The limits here are the drive's
        physical ones: the comfortable accelerations are set by Nav2's velocity smoother,
        and a protective stop has to be able to brake harder than that.
      -->
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>${wheel_separation}</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <max_linear_velocity>1.2</max_linear_velocity>
        <min_linear_velocity>-0.5</min_linear_velocity>
        <max_angular_velocity>2.0</max_angular_velocity>
        <min_angular_velocity>-2.0</min_angular_velocity>
        <max_linear_acceleration>2.5</max_linear_acceleration>
        <min_linear_acceleration>-2.5</min_linear_acceleration>
        <max_angular_acceleration>6.0</max_angular_acceleration>
        <min_angular_acceleration>-6.0</min_angular_acceleration>
        <topic>/cmd_vel</topic>
        <odom_topic>/wheel/odometry</odom_topic>
        <tf_topic>/wheel/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <odom_publish_frequency>50</odom_publish_frequency>
      </plugin>

      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher">
        <topic>/joint_states</topic>
        <joint_name>left_wheel_joint</joint_name>
        <joint_name>right_wheel_joint</joint_name>
      </plugin>

      <!--
        The vehicle's true pose in the world, for measuring how well the stack did. Nothing
        in the stack itself may read it: it exists only in simulation.
      -->
      <plugin filename="gz-sim-odometry-publisher-system"
              name="gz::sim::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <odom_topic>/ground_truth/odometry</odom_topic>
        <tf_topic>/ground_truth/tf</tf_topic>
        <odom_publish_frequency>20</odom_publish_frequency>
        <dimensions>2</dimensions>
      </plugin>
    </gazebo>

    <!--
      Holds the load on the deck. The joint is made between the vehicle and the load model
      wherever the two are when "attach" arrives, so sim_agv (agv_gazebo) first puts the
      load on the deck and then attaches it.

      Three things about this system decide how the simulation starts. It attaches by
      itself as soon as both models exist, so sim_agv's first act is to detach again. It
      reports the joint's state only when the state changes, so sim_agv asks until it hears
      the answer. And while the load model is missing it warns on every physics step, so
      the load is spawned before the vehicle, and a vehicle that will carry nothing
      (load_joint:=false, as for a mapping run) gets no joint at all.
    -->
    <xacro:if value="${load_joint}">
      <gazebo>
        <plugin filename="gz-sim-detachable-joint-system"
                name="gz::sim::systems::DetachableJoint">
          <parent_link>base_footprint</parent_link>
          <child_model>${load_model}</child_model>
          <child_link>link</child_link>
          <attach_topic>/agv/load/attach</attach_topic>
          <detach_topic>/agv/load/detach</detach_topic>
          <output_topic>/agv/load/joint_state</output_topic>
        </plugin>
      </gazebo>
    </xacro:if>

  </xacro:macro>
</robot>
