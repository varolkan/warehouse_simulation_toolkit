<?xml version="1.0" ?>
<!-- The load: a 400 x 300 x 220 mm tote, 4 kg with its contents. Origin at the centre of its base. -->
<sdf version="1.9">
  <model name="tote">
    <link name="link">
      <inertial>
        <pose>0 0 0.09 0 0 0</pose>
        <mass>4.0</mass>
        <inertia>
          <ixx>0.0461</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0695</iyy><iyz>0</iyz>
          <izz>0.0833</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0.11 0 0 0</pose>
        <geometry><box><size>0.40 0.30 0.22</size></box></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
      <visual name="body">
        <pose>0 0 0.105 0 0 0</pose>
        <geometry><box><size>0.40 0.30 0.21</size></box></geometry>
        <material>
          <ambient>0.05 0.25 0.60 1</ambient>
          <diffuse>0.07 0.33 0.78 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <visual name="rim">
        <pose>0 0 0.215 0 0 0</pose>
        <geometry><box><size>0.42 0.32 0.012</size></box></geometry>
        <material>
          <ambient>0.04 0.18 0.45 1</ambient>
          <diffuse>0.05 0.24 0.60 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <visual name="contents">
        <pose>0 0 0.222 0 0 0</pose>
        <geometry><box><size>0.36 0.26 0.004</size></box></geometry>
        <material>
          <ambient>0.60 0.45 0.25 1</ambient>
          <diffuse>0.76 0.60 0.36 1</diffuse>
        </material>
      </visual>
    </link>
    <!-- Where the tote is. The simulated load handler (sim_agv) closes the joint that holds
         the tote on the deck only once Gazebo shows the tote there, and counts a transfer as
         done only once the tote is where it was sent. -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>tote</robot_base_frame>
      <odom_topic>/load/ground_truth</odom_topic>
      <tf_topic>/load/ground_truth/tf</tf_topic>
      <odom_publish_frequency>20</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>
